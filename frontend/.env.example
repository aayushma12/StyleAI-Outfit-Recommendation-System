REACT_APP_API_URL=http://localhost:5000/api

# Cloudinary direct upload (no backend signature required)
# 1. Go to https://cloudinary.com → Settings → Upload → Upload Presets → Add upload preset
# 2. Set Signing Mode to "Unsigned"
# 3. Set Preset name to: styleai_wardrobe
# 4. Save, then fill in the values below
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# Must match CLOUDINARY_CLOUD_NAME in backend/.env.example (same account).
REACT_APP_CLOUDINARY_UPLOAD_PRESET=styleai_wardrobe
