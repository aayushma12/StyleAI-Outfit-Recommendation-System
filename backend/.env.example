# ────────────────────────────────────────────────────────────────
#  StyleAI — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  Never commit .env to version control.
# ────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────
PORT=5000
# development | test | production — anything else is treated as production-safe
# by default (rate limiting, secure cookies, HTTPS upgrade all ON). See config/env.js.
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Required whenever NODE_ENV is not "development"/"test" — this is what CORS
# checks against (see app.js). Should match FRONTEND_URL in a real deployment;
# they're kept separate because FRONTEND_URL is also used to build email links.
CLIENT_URL=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────────────
# Local MongoDB — install from https://www.mongodb.com/try/download/community
MONGO_URI=mongodb://localhost:27017/outfit_recommendation

# ── JWT Authentication ────────────────────────────────────────────
# Use any long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRE=7d

# ── Admin Account ────────────────────────────────────────────────
# Created automatically on first server start if no admin exists in the database.
# Must be set before running the server for the first time.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourStrongPassword123!

# ── Cloudinary (Image Storage) ────────────────────────────────────
# Free account at https://cloudinary.com
# Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email / SMTP ──────────────────────────────────────────────────
# For development: use Mailtrap (free) → https://mailtrap.io
# For production:  use SendGrid, Resend, or your SMTP provider
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM_EMAIL=noreply@styleai.com
SMTP_FROM_NAME=StyleAI

# ── AI Fashion Assistant ──────────────────────────────────────────
# Add ONE of these — only the first found is used.
# FREE:  Google Gemini  → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# FREE:  Groq (Llama)  → https://console.groq.com/keys
GROQ_API_KEY=
# PAID:  Anthropic Claude → https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Python ML Service ────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
